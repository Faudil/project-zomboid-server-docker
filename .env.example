# --- Server Identity ---
SERVER_NAME=servertest
PUBLIC_NAME=My Project Zomboid Server
PUBLIC_SERVER=true

# --- Server Access ---
# Leave ADMIN_PASSWORD / RCON_PASSWORD empty to auto-generate them.
# Generated passwords are stored in <DATA_DIR>/credentials.env on first start.
SERVER_PASSWORD=
ADMIN_PASSWORD=
RCON_PASSWORD=
RCON_PORT=27015

# --- Network ---
DEFAULT_PORT=16261
UDP_PORT=16262
BIND_IP=0.0.0.0

# --- Players ---
MAX_PLAYERS=16
PVP=true
STEAM_VAC=true
USE_STEAM=true
PAUSE_ON_EMPTY=true

# --- World Settings ---
MAP_NAMES=Muldraugh, KY
AUTOSAVE_INTERVAL=15

# --- Sandbox (gameplay tuning) ---
# Any variable prefixed with SANDBOX_ is written to SandboxVars.lua with the
# prefix stripped. Example: SANDBOX_Zombies=2 sets Zombies=2.
# See https://pzwiki.net/wiki/Server_settings for the full list of keys.
# SANDBOX_* overrides always win over SANDBOX_MODE presets.
#
# SANDBOX_MODE selects a preset over the b42 Apocalypse base:
#   apocalypse  (default) - vanilla b42 Apocalypse values
#   performance          - world-cleanup tuning (corpses 48h, blood 7d, rotten
#                          food 14d, rats off) with near-zero gameplay impact
#   max                  - performance + reduced zombie population pressure
#                          for the best TPS on long-running worlds
SANDBOX_MODE=apocalypse
#SANDBOX_Zombies=2
#SANDBOX_DayLength=2
#SANDBOX_WaterShutModifier=20
#
# Nested sandbox tables (ZombieConfig, ZombieLore) use dot notation:
#SANDBOX_ZombieConfig.PopulationMultiplier=0.5
#SANDBOX_ZombieConfig.RallyGroupSize=10
#SANDBOX_ZombieLore.Speed=4

# --- Server Options (INI) ---
# Any variable prefixed with INI_ is written to Server/<SERVER_NAME>.ini with
# the prefix stripped. Example: INI_SleepAllowed=true sets SleepAllowed=true.
# This covers server.ini options that have no dedicated variable above
# (SleepAllowed, SleepNeeded, Faction, safehouse options, ...).
# See https://pzwiki.net/wiki/Server_settings for the full list of keys.
#INI_SleepAllowed=true
#INI_SleepNeeded=false

# --- Memory & Performance ---
# Applied to the JVM by patching ProjectZomboid64.json on every start
# (the game's own default heap is 8g). -Xms equal to -Xmx avoids heap
# resize pauses. On a 16GB host use 8192m; on 8GB hosts stay at 4096m.
MAX_RAM=4096m
MIN_RAM=4096m
GC_CONFIG=ZGC
JVM_EXTRA_ARGS=

# --- Mods ---
# Workshop items to download (semicolon/comma separated). MOD_NAMES is
# optional: when empty it is auto-derived from the downloaded mod folders.
MOD_NAMES=
MOD_WORKSHOP_IDS=
# Instead of listing items, point at a Steam collection you created:
# https://steamcommunity.com/sharedfiles/filedetails/?id=<collection ID>
MOD_WORKSHOP_COLLECTION_IDS=
# Re-download all mods on every start (checks for updates; slower start)
MOD_UPDATE_ON_START=false
# Optional: used to resolve MOD_WORKSHOP_COLLECTION_IDS via the Steam Web API.
# Without a key the public collection page is scraped instead (no key needed);
# set one only if that fails (private collections, Steam page changes).
# Get a free key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Manual mods: unzip mod folders into ./data/Workshop/ (mounted at
# /home/steam/Zomboid/Workshop). They are auto-detected as well.

# --- Updates ---
UPDATE_ON_START=true
SERVER_BRANCH=
STEAM_APP_ID=380870
# Optional Steam credentials. Server files download anonymously via
# DepotDownloader (works reliably without an account). Set STEAM_USER/
# STEAM_PASS only if you need a private/beta branch, or to download
# workshop mods when anonymous fails.
# If your account has Steam Guard enabled, put the one-time code from your
# email into STEAM_GUARD_CODE on first login (it is remembered afterwards).
STEAM_USER=
STEAM_PASS=
STEAM_GUARD_CODE=

# --- Backups ---
BACKUP_ENABLED=false
BACKUP_INTERVAL=360
BACKUP_MAX_COUNT=24
BACKUP_PATH=/home/steam/Zomboid/backups

# --- Discord Webhook ---
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_START=true
DISCORD_NOTIFY_STOP=true
DISCORD_NOTIFY_CRASH=true

# --- Container ---
TZ=UTC
