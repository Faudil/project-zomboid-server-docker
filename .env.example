# ─── Server Identity ──────────────────────────────────────────
SERVER_NAME=servertest
PUBLIC_NAME=My Project Zomboid Server
PUBLIC_SERVER=true

# ─── Server Access ────────────────────────────────────────────
SERVER_PASSWORD=
ADMIN_PASSWORD=
RCON_PASSWORD=
RCON_PORT=27015

# ─── Network ──────────────────────────────────────────────────
DEFAULT_PORT=16261
UDP_PORT=16262
BIND_IP=0.0.0.0

# ─── Players ──────────────────────────────────────────────────
MAX_PLAYERS=16
PVP=true
STEAM_VAC=true
USE_STEAM=true
PAUSE_ON_EMPTY=true

# ─── World Settings ───────────────────────────────────────────
MAP_NAMES=Muldraugh, KY
AUTOSAVE_INTERVAL=15

# ─── Memory & Performance ─────────────────────────────────────
MAX_RAM=4096m
MIN_RAM=4096m
GC_CONFIG=ZGC
JVM_EXTRA_ARGS=

# ─── Mods ─────────────────────────────────────────────────────
MOD_NAMES=
MOD_WORKSHOP_IDS=

# ─── Updates ──────────────────────────────────────────────────
UPDATE_ON_START=true
SERVER_BRANCH=
STEAM_APP_ID=380870

# ─── Backups ──────────────────────────────────────────────────
BACKUP_ENABLED=false
BACKUP_INTERVAL=360
BACKUP_MAX_COUNT=24
BACKUP_PATH=/home/steam/Zomboid/backups

# ─── Discord Webhook ──────────────────────────────────────────
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_START=true
DISCORD_NOTIFY_STOP=true
DISCORD_NOTIFY_CRASH=true
DISCORD_NOTIFY_PLAYERS=false

# ─── Container ────────────────────────────────────────────────
TZ=UTC
PUID=1000
PGID=1000
